# App Config
PROJECT_NAME="CrowdShield AI Backend"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Database
# Default to SQLite for local development
DATABASE_URL="sqlite+aiosqlite:///test.db"

# Optional: PostgreSQL Example
# POSTGRES_USER=crowdshield_user
# POSTGRES_PASSWORD=crowdshield_password
# POSTGRES_DB=crowdshield
# DATABASE_URL=postgresql+asyncpg://crowdshield_user:crowdshield_password@localhost:5432/crowdshield

APP_ENV=development

# Security
JWT_SECRET="development-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
